FROM ubuntu:latest

ADD requirements.txt /app/requirements.txt
ADD ./batch/ /app/
ADD ./batch/csv/ /app/csv/
ADD ./batch/history/ /app/history/
ADD ./batch/log/ /app/log/
ADD ./data/ /HDD2/alice_project/alice_crawler/data/
ADD ./codebase/ /HDD2/alice_project/alice_crawler/codebase/
WORKDIR /app/

# envirement setting
RUN apt-get update && apt-get upgrade -y && apt-get dist-upgrade -y
RUN apt-get install -y locales
RUN locale-gen ko_KR.UTF-8
ENV LC_ALL ko_KR.UTF-8

RUN ln -sf /usr/share/zoneinfo/Asia/Seoul /etc/localtime

# posgres lib for psycopg2(python library)
RUN apt-get install -y libpq-dev


RUN apt-get -y install libncursesw5-dev libgdbm-dev libc6-dev
RUN apt-get -y install zlib1g-dev libsqlite3-dev tk-dev
RUN apt-get -y install libssl-dev openssl
RUN apt-get -y install libffi-dev

